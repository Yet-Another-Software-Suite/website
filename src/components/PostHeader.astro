---
import mascot from "../assets/logo/mascot.png";

export interface Props {
	headline: string;
	dateline: string;
}

const { headline, dateline } = Astro.props;
---

<div class="bg-neutral-50 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 rounded-lg p-8 sm:p-12 text-center mb-8">
	<img src={mascot.src} alt="YASS logo" class="w-12 h-12 mx-auto mb-4 object-contain" />
	<p class="text-neutral-500 dark:text-neutral-400 text-sm mb-2">{dateline}</p>
	<h1 class="text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-white">{headline}</h1>
</div>
