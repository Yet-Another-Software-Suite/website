---
import mascot from "../assets/logo/mascot.png";

export interface Props {
	headline: string;
	dateline: string;
}

const { headline, dateline } = Astro.props;
---

<div class="bg-graphite-panel border border-graphite-border rounded-sm p-8 sm:p-12 text-center mb-8">
	<img src={mascot.src} alt="YASS logo" class="w-12 h-12 mx-auto mb-4 object-contain" />
	<p class="font-mono text-faint text-sm mb-2">{dateline}</p>
	<h1 class="text-2xl sm:text-3xl font-bold text-ink">{headline}</h1>
</div>
