---
// Instagram's oEmbed widget renders unreliably (frequently blank) once framed
// on third-party sites, so instead of embedding live iframes we mirror a
// handful of posts as self-hosted cards that link back to the real post.
// Swap the image/caption/url here to feature different posts.
import yagslSystemcore from "../assets/instagram/ig-yagsl-systemcore.jpg";
import rivetTrivia from "../assets/instagram/ig-rivet-trivia.jpg";
import ionicBondTestimonial from "../assets/instagram/ig-ionic-bond-testimonial.jpg";

const posts = [
	{
		image: yagslSystemcore,
		caption: "YAGSL for SystemCore is live! For those wanting to alpha test new changes, check out Alpha7 on the WPILib page.",
		url: "https://www.instagram.com/yassrobotics/p/DeSjanlORc1/",
	},
	{
		image: rivetTrivia,
		caption: "YASS Trivia! Did you know that Rivet has STRONG opinions about fasteners?",
		url: "https://www.instagram.com/yassrobotics/p/DeNhfjDEfh3/",
	},
	{
		image: ionicBondTestimonial,
		caption: "Working with YASS has been a real advantage for our team — partner team FRC 9738, Ionic Bond.",
		url: "https://www.instagram.com/yassrobotics/p/DdaA3KJNcCU/",
	},
];
---

<div class="grid sm:grid-cols-3 gap-5">
	{posts.map((post) => (
		<a
			href={post.url}
			target="_blank"
			rel="noopener noreferrer"
			class="group block bg-graphite-panel border border-graphite-border rounded-sm overflow-hidden hover:border-yass-600 transition-colors"
		>
			<img
				src={post.image.src}
				alt={post.caption}
				class="w-full aspect-square object-cover"
				loading="lazy"
			/>
			<p class="p-4 text-sm text-dim leading-relaxed line-clamp-3">
				{post.caption}
			</p>
			<p class="px-4 pb-4 font-mono text-xs uppercase tracking-wider text-yass-600 group-hover:underline">
				View on Instagram &rarr;
			</p>
		</a>
	))}
</div>
