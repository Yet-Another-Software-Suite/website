---
// Instagram's oEmbed widget renders unreliably (frequently blank) once framed
// on third-party sites, so instead of embedding live iframes we mirror a
// handful of posts as self-hosted cards that link back to the real post.
// Swap the image/caption/url here to feature different posts.
import yallApriltagSim from "../assets/instagram/ig-yall-apriltag-sim.jpg";
import yamsCpp from "../assets/instagram/ig-yams-cpp.jpg";
import yagslBeta from "../assets/instagram/ig-yagsl-2027-beta.jpg";

const posts = [
	{
		image: yallApriltagSim,
		caption: "New YALL feature! YALL now has built in simulation for AprilTag detection, letting teams do whole robot simulation with vision.",
		url: "https://www.instagram.com/yassrobotics/p/DcoYhz4RWit/",
	},
	{
		image: yamsCpp,
		caption: "Introducing YAMS for C++! No longer a Java exclusive, teams that program in C++ can now use YAMS!",
		url: "https://www.instagram.com/yassrobotics/p/DccUJdgt7dP/",
	},
	{
		image: yagslBeta,
		caption: "We are officially starting to prep for the 2027 season! YAGSL 2027 Beta is officially ready for testing!",
		url: "https://www.instagram.com/yassrobotics/p/DcMyMyVNdNI/",
	},
];
---

<div class="grid sm:grid-cols-3 gap-5">
	{posts.map((post) => (
		<a
			href={post.url}
			target="_blank"
			rel="noopener noreferrer"
			class="group block bg-graphite-panel border border-graphite-border rounded-sm overflow-hidden hover:border-yass-600 transition-colors"
		>
			<img
				src={post.image.src}
				alt={post.caption}
				class="w-full h-auto"
				loading="lazy"
			/>
			<p class="p-4 text-sm text-dim leading-relaxed line-clamp-3">
				{post.caption}
			</p>
			<p class="px-4 pb-4 font-mono text-xs uppercase tracking-wider text-yass-600 group-hover:underline">
				View on Instagram &rarr;
			</p>
		</a>
	))}
</div>
