---
// Instagram's oEmbed widget renders unreliably (frequently blank) once framed
// on third-party sites, so instead of embedding live iframes we mirror a
// handful of posts as self-hosted cards that link back to the real post.
// Swap the image/caption/url here to feature different posts.
import thanksgiving from "../assets/instagram/ig-thanksgiving.jpg";
import partners from "../assets/instagram/ig-partners.jpg";
import meme from "../assets/instagram/ig-meme.jpg";

const posts = [
	{
		image: thanksgiving,
		caption: "Happy Thanksgiving from Rivet and the YASS team!",
		url: "https://www.instagram.com/yassrobotics/p/DgNmWzitfpY/",
	},
	{
		image: partners,
		caption: "Introducing Team YASS for 2026-2027! So excited to partner with these fantastic teams to help shape the future of FRC!",
		url: "https://www.instagram.com/yassrobotics/p/Df8b3U6jdt_/",
	},
	{
		image: meme,
		caption: "This is what happens when a programmer does marketing. Tag a team that should try YASS this year!",
		url: "https://www.instagram.com/yassrobotics/p/DfxrSGSsMuY/",
	},
];

---

<div class="grid sm:grid-cols-3 gap-5">
	{posts.map((post) => (
		<a
			href={post.url}
			target="_blank"
			rel="noopener noreferrer"
			class="group block bg-graphite-panel border border-graphite-border rounded-sm overflow-hidden hover:border-yass-600 transition-colors"
		>
			<img
				src={post.image.src}
				alt={post.caption}
				class="w-full aspect-square object-cover"
				loading="lazy"
			/>
			<p class="p-4 text-sm text-dim leading-relaxed line-clamp-3">
				{post.caption}
			</p>
			<p class="px-4 pb-4 font-mono text-xs uppercase tracking-wider text-yass-600 group-hover:underline">
				View on Instagram &rarr;
			</p>
		</a>
	))}
</div>
