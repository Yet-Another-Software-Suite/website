---
// Instagram's oEmbed widget renders unreliably (frequently blank) once framed
// on third-party sites, so instead of embedding live iframes we mirror a
// handful of posts as self-hosted cards that link back to the real post.
// Swap the image/caption/url here to feature different posts.
import yamgVideo from "../assets/instagram/ig-yamg-video.jpg";
import yamg2027 from "../assets/instagram/ig-yamg-2027.jpg";
import partnerApps from "../assets/instagram/ig-partner-apps.jpg";

const posts = [
	{
		image: yamgVideo,
		caption: "New YouTube video! The new YAMG 2027 features and how to use them, by founding team BroncBotz.",
		url: "https://www.instagram.com/yassrobotics/p/DenaCX1tMZS/",
	},
	{
		image: yamg2027,
		caption: "YAMG 2027 is here! Commands v2 and v3, full simulation, YAMS integration, and more.",
		url: "https://www.instagram.com/yassrobotics/p/DekpJQDMKLA/",
	},
	{
		image: partnerApps,
		caption: "2026-2027 YASS Partner Team Applications are now live! Open to all FRC teams. Deadline: November 13.",
		url: "https://www.instagram.com/yassrobotics/p/DefXaDpBZP0/",
	},
];
---

<div class="grid sm:grid-cols-3 gap-5">
	{posts.map((post) => (
		<a
			href={post.url}
			target="_blank"
			rel="noopener noreferrer"
			class="group block bg-graphite-panel border border-graphite-border rounded-sm overflow-hidden hover:border-yass-600 transition-colors"
		>
			<img
				src={post.image.src}
				alt={post.caption}
				class="w-full aspect-square object-cover"
				loading="lazy"
			/>
			<p class="p-4 text-sm text-dim leading-relaxed line-clamp-3">
				{post.caption}
			</p>
			<p class="px-4 pb-4 font-mono text-xs uppercase tracking-wider text-yass-600 group-hover:underline">
				View on Instagram &rarr;
			</p>
		</a>
	))}
</div>
