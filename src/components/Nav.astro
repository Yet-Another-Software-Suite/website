---
import mascot from "../assets/logo/mascot.png";
import ThemeToggle from "./ThemeToggle.astro";

const links = [
	{ href: "/", label: "Home" },
	{ href: "/projects", label: "Projects" },
	{ href: "/teams", label: "Team YASS" },
	{ href: "/blog", label: "Blog" },
	{ href: "/merch", label: "Merch" },
	{ href: "/contact", label: "Contact" },
];

const currentPath = new URL(Astro.request.url).pathname;
---

<header class="sticky top-0 z-50 bg-graphite/90 backdrop-blur-sm border-b border-graphite-border">
	<nav class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-4">
		<a href="/" class="flex items-center gap-2 shrink-0">
			<img src={mascot.src} alt="YASS logo" class="w-9 h-9 sm:w-10 sm:h-10 object-contain" />
			<span class="font-pixel text-yass-600 text-xs sm:text-sm tracking-wide">YASS</span>
		</a>

		<div class="hidden xl:flex items-center gap-6">
			{links.map((link) => (
				<a
					href={link.href}
					class={`font-mono text-xs uppercase tracking-wider transition-colors ${
						currentPath === link.href
							? "text-yass-600"
							: link.href === "/teams"
								? "text-dim hover:text-partner-pink"
								: "text-dim hover:text-yass-600"
					}`}
				>
					{link.label}
				</a>
			))}
			<a
				href="https://discord.gg/yass"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-block border border-faint text-ink font-mono text-xs uppercase tracking-wider px-4 py-2 rounded-sm hover:border-yass-600 hover:text-yass-600 transition-colors"
			>
				Join Discord
			</a>
			<ThemeToggle />
		</div>

		<div class="flex xl:hidden items-center gap-1">
			<ThemeToggle />
			<button
				id="mobile-menu-toggle"
				type="button"
				aria-label="Toggle menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
				class="p-2.5 rounded-sm text-dim hover:text-yass-600 hover:bg-graphite-panel transition-colors"
			>
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6" id="menu-icon-open">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
				</svg>
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 hidden" id="menu-icon-close">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
				</svg>
			</button>
		</div>
	</nav>

	<div id="mobile-menu" class="hidden xl:hidden border-t border-graphite-border px-4 sm:px-6 py-4">
		<div class="flex flex-col gap-4">
			{links.map((link) => (
				<a
					href={link.href}
					class={`font-mono text-sm uppercase tracking-wider transition-colors ${
						currentPath === link.href
							? "text-yass-600"
							: link.href === "/teams"
								? "text-dim hover:text-partner-pink"
								: "text-dim hover:text-yass-600"
					}`}
				>
					{link.label}
				</a>
			))}
			<a
				href="https://discord.gg/yass"
				target="_blank"
				rel="noopener noreferrer"
				class="self-start inline-block border border-faint text-ink font-mono text-sm uppercase tracking-wider px-5 py-2.5 rounded-sm hover:border-yass-600 hover:text-yass-600 transition-colors"
			>
				Join Discord
			</a>
		</div>
	</div>
</header>

<script>
	function initThemeToggle() {
		const toggles = document.querySelectorAll(".theme-toggle-btn");
		toggles.forEach((toggle) => {
			toggle.addEventListener("click", () => {
				const isDark = document.documentElement.classList.toggle("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
			});
		});
	}

	function initMobileMenu() {
		const menuToggle = document.getElementById("mobile-menu-toggle");
		const menu = document.getElementById("mobile-menu");
		const iconOpen = document.getElementById("menu-icon-open");
		const iconClose = document.getElementById("menu-icon-close");
		if (!menuToggle || !menu || !iconOpen || !iconClose) return;

		menuToggle.addEventListener("click", () => {
			const isOpen = menu.classList.toggle("hidden") === false;
			menuToggle.setAttribute("aria-expanded", String(isOpen));
			iconOpen.classList.toggle("hidden", isOpen);
			iconClose.classList.toggle("hidden", !isOpen);
		});
	}

	document.addEventListener("DOMContentLoaded", () => {
		initThemeToggle();
		initMobileMenu();
	});
</script>
