---
import "../styles/global.css";
import rivet from "../assets/logo/rivet.png";
import Nav from "../components/Nav.astro";

export interface Props {
	title?: string;
	description?: string;
	image?: string;
	url?: string;
}

const {
	title = "Yet Another Software Suite",
	description = "Free, open-source FRC and FTC software: YAGSL, YAMS, YAMG, and YALL. Master programming robots in days, not years.",
	image = "/og-image.png",
	url = "https://yassrobotics.com",
} = Astro.props;
const year = new Date().getFullYear();
---

<html lang="en">
<head>
	<script is:inline>
		const storedTheme = localStorage.getItem("theme");
		const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
		if (storedTheme === "dark" || (!storedTheme && prefersDark)) {
			document.documentElement.classList.add("dark");
		}
	</script>
	<meta charset="utf-8" />
	<link rel="icon" type="image/x-icon" href="/favicon.ico" />
	<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="generator" content={Astro.generator} />
	<meta name="description" content={description} />
	<meta name="keywords" content="FRC, FTC, FIRST Robotics Competition, YASS, Yet Another Software Suite, YAGSL, YAMS, YAMG, YALL, swerve drive library, robot programming, WPILib, robotics software" />
	<link rel="sitemap" href="/sitemap-index.xml" />

	<!-- OpenGraph / Facebook -->
	<meta property="og:type" content="website" />
	<meta property="og:url" content={url} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={new URL(image, Astro.url).href} />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:image:alt" content="Yet Another Software Suite - free, open-source FRC and FTC robot software" />
	<meta property="og:locale" content="en_US" />
	<meta property="og:site_name" content="Yet Another Software Suite" />

	<!-- Twitter -->
	<meta property="twitter:card" content="summary_large_image" />
	<meta property="twitter:url" content={url} />
	<meta property="twitter:title" content={title} />
	<meta property="twitter:description" content={description} />
	<meta property="twitter:image" content={new URL(image, Astro.url).href} />
	<meta property="twitter:image:alt" content="Yet Another Software Suite - free, open-source FRC and FTC robot software" />

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400;1,700&family=Press+Start+2P&display=swap" rel="stylesheet">
	<meta name="theme-color" content="#17191c" />
	<title>{title}</title>
	<slot name="head" />
</head>
<body>
<Nav />
<main>
	<slot />
</main>

<footer class="bg-graphite-panel border-t border-graphite-border text-dim py-10 px-6 text-center">
	<div class="flex flex-col items-center gap-4">
		<div class="relative group">
			<div class="absolute -top-2 left-1/2 -translate-x-1/2 -translate-y-full opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap">
				<div class="relative bg-graphite-raised border border-graphite-border text-ink text-xs font-mono px-3 py-1.5 rounded-sm">
					click me
					<div class="absolute top-full left-1/2 -translate-x-1/2 w-2 h-2 bg-graphite-raised border-b border-r border-graphite-border rotate-45 -mt-1"></div>
				</div>
			</div>
			<button type="button" id="rivet-footer-trigger" class="w-10 h-10 p-0 border-0 bg-transparent cursor-pointer" aria-label="Rivet">
				<img src={rivet.src} alt="Rivet, the YASS mascot" class="w-10 h-10 object-contain" />
			</button>
		</div>
		<div class="flex flex-wrap items-center justify-center gap-5 text-sm font-mono uppercase tracking-wide">
			<a href="https://discord.gg/yass" target="_blank" rel="noopener noreferrer" aria-label="Discord" class="hover:text-yass-600 transition-colors">
				<svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor"><path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.865-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.6 12.6 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.058a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.927 1.793 8.18 1.793 12.061 0a.073.073 0 0 1 .078.01c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.076.076 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.029 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.056c.5-5.177-.838-9.673-3.549-13.662a.06.06 0 0 0-.031-.028ZM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.418 2.157-2.418 1.211 0 2.176 1.094 2.157 2.418 0 1.334-.955 2.419-2.157 2.419Zm7.974 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.418 2.157-2.418 1.211 0 2.176 1.094 2.157 2.418 0 1.334-.946 2.419-2.157 2.419Z"/></svg>
			</a>
			<a href="https://www.instagram.com/yassrobotics" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="hover:text-yass-600 transition-colors">
				<svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.98-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zm0 10.162a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
			</a>
			<a href="https://www.youtube.com/@YASSRobotics" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="hover:text-yass-600 transition-colors">
				<svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor"><path d="M23.498 6.186a3.02 3.02 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.02 3.02 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.02 3.02 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.02 3.02 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
			</a>
			<a href="https://github.com/Yet-Another-Software-Suite" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="hover:text-yass-600 transition-colors">
				<svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.44-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.24 2.75.12 3.04.73.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .3.2.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg>
			</a>
			<a href="/privacy" class="hover:text-yass-600 transition-colors">Privacy Policy</a>
		</div>
		<p class="text-faint text-sm font-mono">&copy; {year} Yet Another Software Suite. Founded by BroncBotz 3481, Grease Monkeys 457, RoboRaiders 3561, and Camber Robotics 9658. :)</p>
	</div>
</footer>

<script>
	function initScrollReveal() {
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add("animate");
				}
			});
		}, {
			threshold: 0.15,
			rootMargin: "0px 0px -80px 0px",
		});

		document.querySelectorAll(".scroll-animate").forEach((el) => {
			observer.observe(el);
		});
	}

	function initRivetFooterEasterEgg() {
		const trigger = document.getElementById("rivet-footer-trigger");
		const footer = document.querySelector("footer");
		if (!trigger || !footer) return;

		trigger.addEventListener("click", () => {
			if (trigger.dataset.animating === "true") return;
			trigger.dataset.animating = "true";

			const footerRect = footer.getBoundingClientRect();
			const triggerRect = trigger.getBoundingClientRect();
			const size = triggerRect.width;
			const img = trigger.querySelector("img");

			const bouncer = document.createElement("img");
			bouncer.src = img.src;
			bouncer.alt = "";
			bouncer.style.position = "fixed";
			bouncer.style.width = size + "px";
			bouncer.style.height = size + "px";
			bouncer.style.left = triggerRect.left + "px";
			bouncer.style.top = triggerRect.top + "px";
			bouncer.style.zIndex = "9999";
			bouncer.style.pointerEvents = "none";
			bouncer.style.filter = "drop-shadow(0 2px 6px rgba(0,0,0,0.4))";
			document.body.appendChild(bouncer);

			const bubble = document.createElement("div");
			bubble.style.position = "fixed";
			bubble.style.zIndex = "10000";
			bubble.style.pointerEvents = "none";
			bubble.innerHTML = `
				<div class="relative bg-graphite-raised border border-graphite-border text-ink text-xs font-mono px-3 py-1.5 rounded-sm whitespace-nowrap">
					WHEEEE!
					<div class="absolute top-full left-1/2 -translate-x-1/2 w-2 h-2 bg-graphite-raised border-b border-r border-graphite-border rotate-45 -mt-1"></div>
				</div>
			`;
			document.body.appendChild(bubble);

			const group = trigger.closest(".group") || trigger;
			group.style.visibility = "hidden";
			bouncer.style.transformOrigin = "center bottom";

			let x = triggerRect.left;
			let y = triggerRect.top;
			let vx = 0;
			let vy = 0;
			let hopDir = Math.random() > 0.5 ? 1 : -1;
			let landed = false;
			let squashAmount = 1;
			const gravity = 0.35;
			const minX = footerRect.left + 4;
			const maxX = footerRect.right - size - 4;
			const groundY = footerRect.bottom - size - 8;

			const startTime = performance.now();
			const duration = 2200;

			function hop() {
				vy = -(7 + Math.random() * 2);
				vx = hopDir * (2.5 + Math.random() * 1.5);
			}

			function frame(now) {
				const elapsed = now - startTime;
				vy += gravity;
				x += vx;
				y += vy;

				if (x < minX) { x = minX; hopDir = 1; }
				if (x > maxX) { x = maxX; hopDir = -1; }

				if (y >= groundY) {
					y = groundY;
					if (!landed || vy > 0) {
						landed = true;
						squashAmount = 0.6;
						if (elapsed < duration) hop();
						else { vx = 0; vy = 0; }
					}
				}
				squashAmount += (1 - squashAmount) * 0.25;

				bouncer.style.left = x + "px";
				bouncer.style.top = y + "px";
				bouncer.style.transform = `scale(${2 - squashAmount}, ${squashAmount})`;

				bubble.style.left = (x + size / 2) + "px";
				bubble.style.top = (y - 10) + "px";
				bubble.style.transform = "translate(-50%, -100%)";

				if (elapsed < duration) {
					requestAnimationFrame(frame);
				} else {
					window.location.href = "/rivet";
				}
			}
			requestAnimationFrame(frame);
		});
	}

	function initPronounCycle() {
		const forms = ["he", "she", "they"];
		const pronouns = document.querySelectorAll(".pronoun-cycle");
		const mustacheBubble = document.getElementById("mustache-bubble");
		const heroImg = document.getElementById("hero-rivet-img");
		const prideCollection = document.getElementById("pride-collection");
		let secretMode = false;

		function checkAllShe() {
			if (!mustacheBubble) return;
			const allShe = pronouns.length > 0 && Array.from(pronouns).every((el) => el.dataset.form === "she");
			mustacheBubble.style.opacity = allShe ? "1" : "";
		}

		function checkAllThey() {
			const allThey = pronouns.length > 0 && Array.from(pronouns).every((el) => el.dataset.form === "they");
			if (heroImg && heroImg.dataset.theySrc) {
				heroImg.src = allThey ? heroImg.dataset.theySrc : heroImg.dataset.defaultSrc;
			}
			if (prideCollection) {
				prideCollection.style.display = allThey ? "block" : "none";
			}
		}

		pronouns.forEach((el) => {
			el.dataset.form = "he";
			el.addEventListener("mouseenter", () => {
				secretMode = false;
				const next = forms[(forms.indexOf(el.dataset.form) + 1) % forms.length];
				el.dataset.form = next;
				el.textContent = el.dataset[next];
				checkAllThey();
				checkAllShe();
			});
		});

		if (heroImg && prideCollection) {
			let prideImages = [];
			try {
				prideImages = JSON.parse(prideCollection.dataset.prideImages || "[]");
			} catch (e) {
				prideImages = [];
			}

			let interactionTimes = [];

			function activateSecretMode() {
				if (prideImages.length === 0) return;
				secretMode = true;
				pronouns.forEach((el) => {
					const randomForm = forms[Math.floor(Math.random() * forms.length)];
					el.dataset.form = randomForm;
					el.textContent = el.dataset[randomForm];
				});
				heroImg.src = prideImages[Math.floor(Math.random() * prideImages.length)];
				prideCollection.style.display = "block";
			}

			function registerHeroInteraction() {
				const now = Date.now();
				interactionTimes.push(now);
				interactionTimes = interactionTimes.filter((t) => now - t <= 30000);
				if (interactionTimes.length >= 30 && !secretMode) {
					activateSecretMode();
				}
			}

			heroImg.addEventListener("mouseenter", registerHeroInteraction);
			heroImg.addEventListener("click", registerHeroInteraction);
		}

		const heroSpeechBubble = document.getElementById("hero-speech-bubble");
		const heroSpeechBubbleText = document.getElementById("hero-speech-bubble-text");
		if (heroImg && heroSpeechBubble && heroSpeechBubbleText) {
			let phrases = [];
			try {
				phrases = JSON.parse(heroSpeechBubble.dataset.phrases || "[]");
			} catch (e) {
				phrases = [];
			}

			let tapCount = 0;
			let speechBubbleTimeout = null;

			heroImg.addEventListener("click", () => {
				tapCount += 1;
				if (tapCount % 3 !== 0 || phrases.length === 0) return;
				const phrase = phrases[Math.floor(Math.random() * phrases.length)];
				heroSpeechBubbleText.textContent = phrase;
				heroSpeechBubble.style.opacity = "1";
				clearTimeout(speechBubbleTimeout);
				speechBubbleTimeout = setTimeout(() => {
					heroSpeechBubble.style.opacity = "";
				}, 2500);
			});
		}

		if (heroImg) {
			let spinClickTimes = [];
			let spinCount = 0;
			const originalDefaultSrc = heroImg.dataset.defaultSrc;

			heroImg.addEventListener("click", () => {
				const now = Date.now();
				spinClickTimes.push(now);
				spinClickTimes = spinClickTimes.filter((t) => now - t <= 60000);
				if (spinClickTimes.length >= 100) {
					spinClickTimes = [];
					heroImg.classList.remove("spin-once");
					void heroImg.offsetWidth;
					heroImg.classList.add("spin-once");
					setTimeout(() => {
						heroImg.classList.remove("spin-once");
						spinCount = (spinCount % 3) + 1;
						let newSrc = originalDefaultSrc;
						if (spinCount === 1 && heroImg.dataset.lriSrc) newSrc = heroImg.dataset.lriSrc;
						else if (spinCount === 2 && heroImg.dataset.csaSrc) newSrc = heroImg.dataset.csaSrc;
						heroImg.dataset.defaultSrc = newSrc;
						heroImg.src = newSrc;
					}, 700);
				}
			});
		}
	}

	document.addEventListener("DOMContentLoaded", () => {
		initScrollReveal();
		initRivetFooterEasterEgg();
		initPronounCycle();
	});
</script>
</body>
</html>
