---
import { projects } from "../data/projects.js";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Projects - Yet Another Software Suite"
	description="YAGSL, YAMS, YAMG, and YALL: free, open-source libraries for FRC and FTC robot programming."
	url="https://yassrobotics.com/projects"
>
	<section class="py-16 sm:py-20 px-4 sm:px-6">
		<div class="max-w-3xl mx-auto text-center">
			<h1 class="text-4xl sm:text-5xl font-bold mb-4 sm:mb-6 text-yass-600">
				Our Projects
			</h1>
			<p class="text-base sm:text-lg text-dim leading-relaxed">
				Every library we build is free, open source, and documented well enough that a team without a software mentor can still get a robot running.
			</p>
		</div>
	</section>

	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-graphite-panel/40 border-y border-graphite-border">
		<div class="max-w-4xl mx-auto space-y-6">
			{projects.map((project, i) => (
				<div
					class="bg-graphite-panel border border-graphite-border rounded-sm p-6 sm:p-8"
					style={`border-left: 3px solid ${project.ledColor ?? "var(--color-faint)"};`}
				>
					<div class="flex items-start justify-between gap-4 mb-4">
						<div>
							<h2 class="text-4xl font-bold text-ink">
								<a href={project.docs ?? project.extra?.url} target="_blank" rel="noopener noreferrer">{project.name}</a>
							</h2>
							<p class="font-mono text-sm font-bold uppercase tracking-wider" style={`color: ${project.ledColor ?? "var(--color-dim)"};`}>{project.fullName}</p>
						</div>
						{project.logo && (
							<img src={project.logo.src} alt={`${project.name} logo`} class="w-28 h-28 object-contain shrink-0" />
						)}
					</div>
					<p class="text-sm sm:text-base text-dim leading-relaxed mb-6">
						{project.description}
					</p>
					<div class="flex flex-wrap gap-3">
						{project.extra?.primary && (
							<a
								href={project.extra.url}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-block rounded-sm bg-yass-600 text-on-accent text-sm font-bold font-mono uppercase tracking-wider px-4 py-2.5 hover:bg-yass-500 transition-colors"
							>
								{project.extra.label}
							</a>
						)}
						{project.docs && (
							<a
								href={project.docs}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-block rounded-sm bg-yass-600 text-on-accent text-sm font-bold font-mono uppercase tracking-wider px-4 py-2.5 hover:bg-yass-500 transition-colors"
							>
								Read the Docs
							</a>
						)}
						<a
							href={project.github}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-block rounded-sm border border-faint text-ink text-sm font-mono uppercase tracking-wider px-4 py-2.5 hover:border-ink transition-colors"
						>
							View on GitHub
						</a>
						{project.extra && !project.extra.primary && (
							<a
								href={project.extra.url}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-block rounded-sm border border-faint text-ink text-sm font-mono uppercase tracking-wider px-4 py-2.5 hover:border-ink transition-colors"
							>
								{project.extra.label}
							</a>
						)}
					</div>
				</div>
			))}
		</div>
	</section>

	<section class="py-16 sm:py-24 px-4 sm:px-6">
		<div class="max-w-2xl mx-auto text-center scroll-animate">
			<h2 class="text-3xl sm:text-4xl font-bold text-ink mb-4">Found a Bug? Have an Idea?</h2>
			<p class="text-dim mb-8">
				Issues and pull requests are welcome on any of our repos. For general questions, the Discord is the best place to ask.
			</p>
			<div class="flex flex-col sm:flex-row justify-center gap-4">
				<a
					href="https://github.com/Yet-Another-Software-Suite"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-block rounded-sm bg-yass-600 text-on-accent font-bold font-mono text-xs uppercase tracking-wider px-6 py-3.5 hover:bg-yass-500 transition-colors"
				>
					Browse Our GitHub
				</a>
				<a
					href="https://discord.gg/yass"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-block rounded-sm border border-faint text-ink font-mono text-xs uppercase tracking-wider px-6 py-3.5 hover:border-ink transition-colors"
				>
					Ask on Discord
				</a>
			</div>
		</div>
	</section>
</Layout>
