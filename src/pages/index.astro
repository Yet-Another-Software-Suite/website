---
import { projects } from "../data/projects.js";
import InstagramFeed from "../components/InstagramFeed.astro";
import YouTubeFeed from "../components/YouTubeFeed.astro";
import Layout from "../layouts/Layout.astro";
import rivetHero from "../assets/logo/rivet.png";
---

<Layout
	title="Yet Another Software Suite"
	description="Free, open-source FRC and FTC software built by students, for students: YAGSL, YAMS, YAMG, and YALL."
	url="https://yassrobotics.com"
>
	<!-- Hero -->
	<section class="pt-16 pb-12 sm:pt-20 sm:pb-16">
		<div class="plate px-4 sm:px-6 lg:px-12 py-12 sm:py-14 scroll-animate">
			<div class="max-w-5xl mx-auto flex items-center gap-8 lg:gap-12">
			<div class="flex-1">
				<div class="mb-6">
					<span class="font-mono text-xs uppercase tracking-widest text-dim">Open source &middot; FRC Team Software</span>
				</div>
				<h1 class="font-pixel text-2xl sm:text-3xl md:text-4xl leading-relaxed text-yass-600 max-w-2xl">
					Yet Another<br /><span class="text-yass-600">Software Suite</span>
				</h1>
				<p class="text-base sm:text-lg text-dim max-w-xl mt-6 leading-relaxed">
					Four vendor-agnostic libraries for swerve drives, mechanisms, vision, and mechanism design &mdash; built by FRC teams, for FRC teams, with simulation baked in from day one.
				</p>
				<div class="flex flex-wrap gap-3 mt-8">
					<a
						href="https://github.com/Yet-Another-Software-Suite"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider px-6 py-3.5 rounded-sm bg-yass-600 text-on-accent font-bold hover:bg-yass-500 transition-colors"
					>
						Browse GitHub &rarr;
					</a>
					<a href="/projects" class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider px-6 py-3.5 rounded-sm border border-faint text-ink hover:border-ink transition-colors">
						See the Libraries
					</a>
					<a
						href="https://discord.gg/yass"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider px-6 py-3.5 rounded-sm border border-faint text-ink hover:border-ink transition-colors"
					>
						Join Discord
					</a>
				</div>
				<div class="flex flex-wrap gap-x-10 gap-y-4 mt-12 pt-6 border-t border-graphite-border">
					<div>
						<div class="font-display text-3xl font-bold text-yass-600">4</div>
						<div class="font-mono text-xs uppercase tracking-wider text-dim">Libraries</div>
					</div>
					<div>
						<div class="font-display text-3xl font-bold text-yass-600">500+</div>
						<div class="font-mono text-xs uppercase tracking-wider text-dim">Teams running YASS</div>
					</div>
					<div>
						<div class="font-display text-3xl font-bold text-yass-600">100%</div>
						<div class="font-mono text-xs uppercase tracking-wider text-dim">Open source</div>
					</div>
				</div>
			</div>
			<img src={rivetHero.src} alt="Rivet, the YASS mascot" class="hidden md:block w-40 lg:w-52 h-40 lg:h-52 object-contain shrink-0" />
			</div>
		</div>
	</section>

	<div class="hazard-stripe"></div>

	<!-- The Suite -->
	<section id="libraries" class="py-16 sm:py-20 px-4 sm:px-6">
		<div class="max-w-6xl mx-auto scroll-animate">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="text-3xl sm:text-4xl font-bold text-yass-600">YASS Libraries</h2>
				<p class="text-dim max-w-sm text-sm">Each library owns one part of the stack. Use one, use all four &mdash; they're built to share a philosophy, not force a dependency.</p>
			</div>
			<div class="grid sm:grid-cols-2 gap-4 sm:gap-5">
				{projects.map((project) => (
					<div
						class="bg-graphite-panel border border-graphite-border rounded-sm p-6 hover:-translate-y-0.5 transition-transform"
						style={`border-left: 3px solid ${project.ledColor ?? "var(--color-faint)"};`}
					>
						<div class="flex items-start justify-between gap-3 mb-3">
							<div>
								<h3 class="text-3xl font-bold text-ink">
									<a href={project.docs ?? project.extra?.url} target="_blank" rel="noopener noreferrer">{project.name}</a>
								</h3>
								<p class="font-mono text-sm font-bold uppercase tracking-wider" style={`color: ${project.ledColor ?? "var(--color-dim)"};`}>{project.fullName}</p>
							</div>
							{project.logo && (
								<img src={project.logo.src} alt={`${project.name} logo`} class="w-16 h-16 object-contain shrink-0" />
							)}
						</div>
						<p class="text-sm text-dim leading-relaxed mb-5">{project.description}</p>
						<div class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs">
							{project.extra?.primary && (
								<a href={project.extra.url} target="_blank" rel="noopener noreferrer" class="text-ink border-b border-faint hover:border-yass-600 hover:text-yass-600 pb-0.5 transition-colors">{project.extra.label}</a>
							)}
							{project.docs && (
								<a href={project.docs} target="_blank" rel="noopener noreferrer" class="text-ink border-b border-faint hover:border-yass-600 hover:text-yass-600 pb-0.5 transition-colors">Docs</a>
							)}
							<a href={project.github} target="_blank" rel="noopener noreferrer" class="text-ink border-b border-faint hover:border-yass-600 hover:text-yass-600 pb-0.5 transition-colors">GitHub</a>
							{project.extra && !project.extra.primary && (
								<a href={project.extra.url} target="_blank" rel="noopener noreferrer" class="text-ink border-b border-faint hover:border-yass-600 hover:text-yass-600 pb-0.5 transition-colors">{project.extra.label}</a>
							)}
						</div>
					</div>
				))}
			</div>
			<p class="text-center mt-10">
				<a href="/projects" class="font-mono text-base sm:text-lg uppercase tracking-wider text-yass-600 hover:underline">Learn more about every project &rarr;</a>
			</p>
		</div>
	</section>

	<div class="hazard-stripe"></div>

	<!-- Instagram -->
	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-graphite-panel/40">
		<div class="max-w-5xl mx-auto scroll-animate">
			<h2 class="text-3xl sm:text-4xl font-bold text-center mb-2 text-yass-600">Instagram</h2>
			<p class="text-center text-dim mb-10 text-base sm:text-lg">
				Follow us on social media for quick updates, testimonials, and announcements.
			</p>
			<InstagramFeed />
			<p class="text-center mt-10">
				<a href="https://www.instagram.com/yassrobotics" target="_blank" rel="noopener noreferrer" class="font-mono text-base sm:text-lg uppercase tracking-wider text-yass-600 hover:underline">@yassrobotics &rarr;</a>
			</p>
		</div>
	</section>

	<div class="hazard-stripe"></div>

	<!-- YouTube -->
	<section class="py-16 sm:py-20 px-4 sm:px-6">
		<div class="max-w-5xl mx-auto text-center scroll-animate">
			<h2 class="text-3xl sm:text-4xl font-bold mb-2 text-yass-600">YouTube</h2>
			<p class="text-dim mb-10 text-base sm:text-lg">Subscribe on YouTube for tutorials, YASS Weekly recordings, and more.</p>
			<YouTubeFeed />
			<p class="mt-10">
				<a
					href="https://www.youtube.com/@YASSRobotics"
					target="_blank"
					rel="noopener noreferrer"
					class="font-mono text-base sm:text-lg uppercase tracking-wider text-yass-600 hover:underline"
				>
					youtube.com/yassrobotics &rarr;
				</a>
			</p>
		</div>
	</section>

	<div class="hazard-stripe"></div>

	<!-- CTA -->
	<section class="text-center py-20 sm:py-24 px-4 sm:px-6">
		<div class="max-w-xl mx-auto scroll-animate">
			<h2 class="text-4xl sm:text-5xl font-bold text-ink mb-4">Built by the community,<br />proven on real robots.</h2>
			<p class="font-mono text-sm text-dim tracking-wide mb-8">YAGSL | YALL | YAMS | YAMG</p>
		</div>
		<div class="max-w-4xl mx-auto flex flex-wrap justify-center gap-3 scroll-animate">
			<a
				href="https://github.com/Yet-Another-Software-Suite"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider px-6 py-3.5 rounded-sm bg-yass-600 text-on-accent font-bold hover:bg-yass-500 transition-colors"
			>
				Browse GitHub &rarr;
			</a>
			<a
				href="https://discord.gg/yass"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider px-6 py-3.5 rounded-sm border border-faint text-ink hover:border-ink transition-colors"
			>
				Join Discord
			</a>
			<a
				href="https://www.youtube.com/@YASSRobotics"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider px-6 py-3.5 rounded-sm border border-faint text-ink hover:border-ink transition-colors"
			>
				Subscribe on YouTube
			</a>
			<a
				href="https://www.instagram.com/yassrobotics"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider px-6 py-3.5 rounded-sm border border-faint text-ink hover:border-ink transition-colors"
			>
				Follow on Instagram
			</a>
		</div>
	</section>
</Layout>
