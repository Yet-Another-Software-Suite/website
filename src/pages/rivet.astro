---
import rivetHero from "../assets/logo/rivet.png";
import battery from "../assets/rivet/battery.png";
import csa from "../assets/rivet/csa.png";
import lri from "../assets/rivet/lri.png";
import referee from "../assets/rivet/referee.png";
import graduating from "../assets/rivet/graduating.png";
import christmas from "../assets/rivet/christmas.png";
import newYears from "../assets/rivet/new-years.png";
import lucky from "../assets/rivet/lucky.png";
import pi from "../assets/rivet/pi.png";
import valentines from "../assets/rivet/valentines.png";
import easter from "../assets/rivet/easter.png";
import pride from "../assets/rivet/pride.png";
import Layout from "../layouts/Layout.astro";

const roles = [
	{
		image: csa,
		title: "Control Systems Advisor",
		description: "Rivet volunteers as a CSA at FRC events, helping teams track down wiring gremlins before they cost a match.",
		accent: "#f55d11",
	},
	{
		image: lri,
		title: "Lead Robot Inspector",
		description: 'As an LRI, Rivet has inspected more robots than <span class="pronoun-cycle" data-he="he can count" data-she="she can count" data-they="they can count">he can count</span>, clipboard in hand, tape measure ready.',
		accent: "#f5d611",
	},
	{
		image: referee,
		title: "FTC Referee",
		description: 'Whistle around <span class="pronoun-cycle" data-he="his" data-she="her" data-they="their">his</span> neck, penalty stick ready, Rivet also shows up to FTC events as a referee.',
	},
];

const rainbowColors = ["#e40303", "#ff8c00", "#ffed00", "#008026", "#004dff", "#750787"];

const holidays = [
	{
		image: newYears,
		title: "New Year's",
		description: 'Rivet rings in the new year with a sparkler in one hand and a list of resolutions <span class="pronoun-cycle" data-he="he\'ll" data-she="she\'ll" data-they="they\'ll">he\'ll</span> abandon by Kickoff.',
	},
	{
		image: valentines,
		title: "Valentine's Day",
		description: 'Rivet swaps in a pair of heart-eyed glasses and leaves little paper hearts on every desk in the build space, because <span class="pronoun-cycle" data-he="he\'s" data-she="she\'s" data-they="they\'re">he\'s</span> a romantic at heart.',
	},
	{
		image: pi,
		title: "Pi Day",
		description: 'On Pi Day, Rivet challenges the whole team to a pi-memorization contest and insists <span class="pronoun-cycle" data-he="he won" data-she="she won" data-they="they won">he won</span> every year, even when nobody kept score.',
	},
	{
		image: lucky,
		title: "St. Patrick's Day",
		description: 'On St. Patrick\'s Day, Rivet insists <span class="pronoun-cycle" data-he="he\'s" data-she="she\'s" data-they="they\'re">he\'s</span> part leprechaun and spends the whole event hunting the pits for a pot of gold that never turns up.',
	},
	{
		image: easter,
		title: "Easter",
		description: 'Rivet dons bunny ears and hides painted eggs in robot totes, convinced <span class="pronoun-cycle" data-he="he\'s" data-she="she\'s" data-they="they\'re">he\'s</span> the best egg hider on the team.',
	},
	{
		image: pride,
		title: "Pride Month",
		description: 'Rivet spends Pride Month splashing rainbow paint on everything in sight, because <span class="pronoun-cycle" data-he="he figures" data-she="she figures" data-they="they figure">he figures</span> the pronouns should get to have some fun too.',
		rainbow: true,
	},
	{
		image: christmas,
		title: "Christmas",
		description: 'Every Christmas, Rivet swaps <span class="pronoun-cycle" data-he="his" data-she="her" data-they="their">his</span> usual look for a santa hat and leaves a stocking full of spare bolts on the workbench, insisting <span class="pronoun-cycle" data-he="he\'s" data-she="she\'s" data-they="they\'ve">he\'s</span> been extra good this year.',
	},
];
---

<Layout
	title="Rivet - Yet Another Software Suite"
	description="The lore of Rivet, the YASS mascot."
	url="https://yassrobotics.com/rivet"
>
	<section class="py-16 sm:py-20 px-4 sm:px-6">
		<div class="max-w-2xl mx-auto text-center scroll-animate">
			<div class="relative inline-block mb-6">
				<div id="mustache-bubble" class="absolute -top-2 left-1/2 -translate-x-1/2 -translate-y-full opacity-0 transition-opacity pointer-events-none whitespace-nowrap">
					<div class="relative bg-graphite-raised border border-graphite-border text-ink text-xs font-mono px-3 py-1.5 rounded-sm">
						did you know my mustache is fake!
						<div class="absolute top-full left-1/2 -translate-x-1/2 w-2 h-2 bg-graphite-raised border-b border-r border-graphite-border rotate-45 -mt-1"></div>
					</div>
				</div>
				<img
					id="hero-rivet-img"
					src={rivetHero.src}
					data-default-src={rivetHero.src}
					data-they-src={pride.src}
					alt="Rivet, the YASS mascot"
					class="w-32 h-32 sm:w-40 sm:h-40 object-contain"
				/>
			</div>
			<h1 class="text-4xl sm:text-5xl font-bold mb-4 text-yass-600">Rivet</h1>
			<p class="text-base sm:text-lg text-dim leading-relaxed">
				You found <span class="pronoun-cycle" data-he="him" data-she="her" data-they="them">him</span>. Here's the story of the frog behind the software.
			</p>
		</div>
	</section>

	<div class="hazard-stripe"></div>

	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-graphite-panel/40">
		<div class="max-w-3xl mx-auto text-center scroll-animate">
			<h2 class="text-3xl sm:text-4xl font-bold mb-6 text-ink">Who is Rivet?</h2>
			<p class="text-base sm:text-lg text-dim leading-relaxed mb-4">
				Rivet is the mascot of Yet Another Software Suite, a frog who loves to program, volunteer, and help students learn robotics as a whole. <span class="pronoun-cycle" data-he="He's" data-she="She's" data-they="They're">He's</span> a bit crazy; <span class="pronoun-cycle" data-he="he'll" data-she="she'll" data-they="they'll">he'll</span> do things like licking batteries in public, purely because <span class="pronoun-cycle" data-he="he's" data-she="she's" data-they="they're">he's</span> curious whether they're charged.
			</p>
			<p class="text-base sm:text-lg text-dim leading-relaxed mb-4">
				<span class="pronoun-cycle" data-he="He'll" data-she="She'll" data-they="They'll">He'll</span> cause a little chaos, help anyone who asks for it, and encourages students of every skill level to do the same.
			</p>
			<p class="text-base sm:text-lg text-dim leading-relaxed mb-4">
				<span class="pronoun-cycle" data-he="He's" data-she="She's" data-they="They're">He's</span> also a frog, so <span class="pronoun-cycle" data-he="he switches" data-she="she switches" data-they="they switch">he switches</span> genders whenever <span class="pronoun-cycle" data-he="he feels" data-she="she feels" data-they="they feel">he feels</span> like it; don't be surprised if the pronouns around here shift too.
			</p>
			<p class="text-base sm:text-lg text-dim leading-relaxed">
				Rivet's ultimate goal is simple: save teams time, money, and grief with the power of simulation and the open knowledge YASS offers for everyone; or lick a battery on Einstein. Whichever comes first.
			</p>
		</div>
	</section>

	<section class="py-16 sm:py-20 px-4 sm:px-6">
		<div class="max-w-5xl mx-auto scroll-animate">
			<h2 class="text-3xl sm:text-4xl font-bold text-center mb-10 text-ink">On the Job</h2>
			<div class="grid sm:grid-cols-3 gap-5">
				{roles.map((role) => (
					<figure
						class="bg-graphite-panel border border-graphite-border rounded-sm p-6 flex flex-col items-center text-center transition-colors [--role-accent:var(--color-yass-600)] hover:border-[var(--role-accent)]"
						style={role.accent ? `--role-accent: ${role.accent};` : undefined}
					>
						<img src={role.image.src} alt={role.title} class="w-28 h-28 object-contain mb-4" />
						<figcaption class="text-lg font-semibold text-ink mb-2">{role.title}</figcaption>
						<p class="text-sm text-dim leading-relaxed" set:html={role.description} />
					</figure>
				))}
			</div>
		</div>
	</section>

	<div class="hazard-stripe"></div>

	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-graphite-panel/40">
		<div class="max-w-3xl mx-auto scroll-animate">
			<div class="grid sm:grid-cols-2 gap-5 items-center">
				<img src={battery.src} alt="Rivet licking a battery" class="w-full h-auto" />
				<div>
					<h2 class="text-2xl sm:text-3xl font-bold mb-3 text-ink">Curious to a Fault</h2>
					<p class="text-dim leading-relaxed">
						Is that battery charged? Only one way to find out. Rivet's scientific method leaves a little to be desired, but nobody can say <span class="pronoun-cycle" data-he="he isn't" data-she="she isn't" data-they="they aren't">he isn't</span> thorough.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 sm:py-20 px-4 sm:px-6">
		<div class="max-w-3xl mx-auto scroll-animate">
			<div class="grid sm:grid-cols-2 gap-5 items-center">
				<div class="sm:order-2">
					<img src={graduating.src} alt="Rivet in a graduation cap" class="w-full h-auto" />
				</div>
				<div class="sm:order-1">
					<h2 class="text-2xl sm:text-3xl font-bold mb-3 text-ink">Every Graduation</h2>
					<p class="text-dim leading-relaxed">
						Rivet is right there alongside students every year as they graduate: cap, tassel, and all.
					</p>
				</div>
			</div>
		</div>
	</section>

	<div class="hazard-stripe"></div>

	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-graphite-panel/40">
		<div class="max-w-2xl mx-auto text-center scroll-animate">
			<h2 class="text-3xl sm:text-4xl font-bold mb-4 text-ink">Rivet's Fan Club</h2>
			<p class="text-base sm:text-lg text-dim leading-relaxed" set:html={`<span class="text-partner-pink font-semibold">Partner teams</span> are the official officers of Rivet's fan club, whether they signed up for it or not. Keep an eye out at your next competition; a lot of them hand out Rivet stickers in their pits. <span class="pronoun-cycle" data-he="He swears" data-she="She swears" data-they="They swear">He swears</span> it's for outreach, but everyone's pretty sure <span class="pronoun-cycle" data-he="he" data-she="she" data-they="they">he</span> just likes seeing <span class="pronoun-cycle" data-he="his own face" data-she="her own face" data-they="their own face">his own face</span> on people's laptops and likes to joyride on robots.`} />
		</div>
	</section>

	<div class="hazard-stripe"></div>

	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-graphite-panel/40">
		<div class="max-w-5xl mx-auto scroll-animate">
			<h2 class="text-3xl sm:text-4xl font-bold text-center mb-2 text-ink">Dressed for the Occasion</h2>
			<p class="text-center text-dim mb-10">Rivet loves to dress up for the holidays.</p>
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-5">
				{holidays.map((holiday) => (
					<figure class="bg-graphite-panel border border-graphite-border rounded-sm p-4 flex flex-col items-center text-center hover:border-yass-600 transition-colors">
						<img src={holiday.image.src} alt={`Rivet dressed up for ${holiday.title}`} class="w-full h-auto mb-3" />
						<figcaption class={`text-sm font-mono uppercase tracking-wider mb-2 ${holiday.rainbow ? "" : "text-yass-600"}`}>
							{holiday.rainbow
								? holiday.title.split("").map((char, i) => (
									<span style={`color: ${rainbowColors[i % rainbowColors.length]};`}>{char}</span>
								))
								: holiday.title}
						</figcaption>
						<p class="text-xs text-dim leading-relaxed" set:html={holiday.description} />
					</figure>
				))}
			</div>
		</div>
	</section>
</Layout>
