---
import { getCollection } from "astro:content";
import mascot from "../../assets/logo/mascot.png";
import { blogImages } from "../../data/blogImages.js";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.sortDate.valueOf() - a.data.sortDate.valueOf(),
);
const [latest, ...rest] = posts;

function formatDate(post) {
	return (
		post.data.displayDate ??
		post.data.sortDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
	);
}

const latestImg = latest?.data.image ? blogImages[latest.data.image] : null;
---

<Layout
	title="Blog - Yet Another Software Suite"
	description="Release notes, competition updates, and everything else from the teams building YASS."
	url="https://yassrobotics.com/blog"
>
	<section class="py-16 sm:py-20 px-4 sm:px-6">
		<div class="max-w-3xl mx-auto text-center">
			<h1 class="text-4xl sm:text-5xl font-bold mb-4 sm:mb-6 text-yass-600">
				Blog
			</h1>
			<p class="text-base sm:text-lg text-dim leading-relaxed">
				Release notes, competition updates, and everything else we've been building.
			</p>
		</div>
	</section>

	{latest ? (
		<section class="py-16 sm:py-20 px-4 sm:px-6 bg-graphite-panel/40 border-y border-graphite-border">
			<div class="max-w-4xl mx-auto">
				<a
					href={`/blog/${latest.id}`}
					class="block bg-graphite-panel border border-graphite-border rounded-sm overflow-hidden hover:border-yass-600 transition-colors mb-8"
				>
					{latestImg ? (
						<img src={latestImg.src} alt={latest.data.imageAlt} class="w-full h-48 sm:h-64 object-cover" />
					) : (
						<div class="h-32 sm:h-40 flex items-center justify-center bg-graphite-raised">
							<img src={mascot.src} alt="YASS logo" class="w-14 h-14 object-contain" />
						</div>
					)}
					<div class="p-6">
						<p class="text-yass-600 font-mono font-semibold text-xs uppercase tracking-wide mb-2">Latest Post</p>
						<p class="font-mono text-faint text-sm mb-1">{formatDate(latest)}</p>
						<h2 class="text-xl sm:text-2xl font-bold text-ink mb-2">{latest.data.title}</h2>
						<p class="text-sm sm:text-base text-dim leading-relaxed">{latest.data.excerpt}</p>
						<p class="mt-4 font-mono text-xs uppercase tracking-wider text-yass-600">Read the full post &rarr;</p>
					</div>
				</a>

				<div class="grid gap-4 sm:gap-5">
					{rest.map((post) => {
						const img = post.data.image ? blogImages[post.data.image] : null;
						return (
							<a
								href={`/blog/${post.id}`}
								class="block bg-graphite-panel border border-graphite-border rounded-sm overflow-hidden hover:border-yass-600 transition-colors"
							>
								<div class="sm:flex sm:items-center">
									{img && (
										<img
											src={img.src}
											alt={post.data.imageAlt}
											class="w-full sm:w-48 h-40 sm:h-32 object-cover shrink-0"
										/>
									)}
									<div class="p-5 sm:p-6">
										<p class="font-mono text-faint text-sm mb-1">{formatDate(post)}</p>
										<h2 class="text-lg sm:text-xl font-bold text-ink mb-1">{post.data.title}</h2>
										<p class="text-sm sm:text-base text-dim leading-relaxed">{post.data.excerpt}</p>
									</div>
								</div>
							</a>
						);
					})}
				</div>
			</div>
		</section>
	) : (
		<section class="py-16 sm:py-20 px-4 sm:px-6 bg-graphite-panel/40 border-y border-graphite-border">
			<div class="max-w-2xl mx-auto text-center text-dim">
				<p>No posts yet. Check back soon.</p>
			</div>
		</section>
	)}
</Layout>
