---
import { getCollection, render } from "astro:content";
import PostHeader from "../../components/PostHeader.astro";
import { blogImages } from "../../data/blogImages.js";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	const chronological = [...posts].sort((a, b) => a.data.sortDate.valueOf() - b.data.sortDate.valueOf());

	return chronological.map((post, index) => {
		const otherPosts = posts
			.filter((p) => p.id !== post.id)
			.sort((a, b) => b.data.sortDate.valueOf() - a.data.sortDate.valueOf())
			.slice(0, 6);

		return {
			params: { slug: post.id },
			props: {
				post,
				prevPost: chronological[index - 1] ?? null,
				nextPost: chronological[index + 1] ?? null,
				otherPosts,
			},
		};
	});
}

const { post, prevPost, nextPost, otherPosts } = Astro.props;
const { Content } = await render(post);

function formatDate(p) {
	return (
		p.data.displayDate ??
		p.data.sortDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
	);
}

const dateline = formatDate(post);
const img = post.data.image ? blogImages[post.data.image] : null;
---

<Layout
	title={`${post.data.title} - YASS Blog`}
	description={post.data.excerpt}
	url={`https://yassrobotics.com/blog/${post.id}`}
>
	<section class="py-16 sm:py-20 px-4 sm:px-6">
		<div class="max-w-6xl mx-auto grid lg:grid-cols-3 gap-10">
			<div class="lg:col-span-2">
				<a href="/blog" class="inline-block font-mono text-xs uppercase tracking-wider text-yass-600 hover:underline mb-8">
					&larr; Back to Blog
				</a>

				{img ? (
					<>
						<img src={img.src} alt={post.data.imageAlt} class="w-full h-56 sm:h-72 object-cover rounded-sm mb-6" />
						<p class="font-mono text-faint text-sm mb-2">{dateline}</p>
						<h1 class="text-2xl sm:text-3xl font-bold text-ink mb-8">{post.data.title}</h1>
					</>
				) : (
					<PostHeader headline={post.data.title} dateline={dateline} />
				)}

				<div class="post-content text-base sm:text-lg text-dim leading-relaxed">
					<Content />
				</div>

				{post.data.source && (
					<p class="mt-8 pt-6 border-t border-graphite-border font-mono text-xs text-faint">
						Originally posted on <a href={post.data.source} target="_blank" rel="noopener noreferrer" class="font-semibold text-yass-600 hover:underline">Chief Delphi</a>.
					</p>
				)}

				<div class="grid sm:grid-cols-2 gap-4 mt-12 pt-8 border-t border-graphite-border">
					{prevPost ? (
						<a
							href={`/blog/${prevPost.id}`}
							class="block bg-graphite-panel border border-graphite-border rounded-sm p-4 hover:border-yass-600 transition-colors"
						>
							<p class="font-mono text-xs text-faint mb-1">&larr; Previous</p>
							<p class="text-sm font-semibold text-ink">{prevPost.data.title}</p>
						</a>
					) : (
						<div />
					)}
					{nextPost ? (
						<a
							href={`/blog/${nextPost.id}`}
							class="block text-right bg-graphite-panel border border-graphite-border rounded-sm p-4 hover:border-yass-600 transition-colors sm:col-start-2"
						>
							<p class="font-mono text-xs text-faint mb-1">Next &rarr;</p>
							<p class="text-sm font-semibold text-ink">{nextPost.data.title}</p>
						</a>
					) : (
						<div />
					)}
				</div>
			</div>

			<aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
				<div class="bg-graphite-panel border border-graphite-border rounded-sm p-6">
					<h2 class="font-bold text-ink mb-4">More From the Blog</h2>
					<ul class="space-y-4">
						{otherPosts.map((p) => (
							<li>
								<a href={`/blog/${p.id}`} class="block group">
									<p class="font-mono text-xs text-faint">{formatDate(p)}</p>
									<p class="text-sm font-semibold text-ink group-hover:text-yass-600 transition-colors">
										{p.data.title}
									</p>
								</a>
							</li>
						))}
					</ul>
					<a href="/blog" class="inline-block mt-4 font-mono text-xs uppercase tracking-wider text-yass-600 hover:underline">
						View all posts &rarr;
					</a>
				</div>

				<div class="bg-graphite-panel border border-graphite-border rounded-sm p-6 text-center">
					<h2 class="font-bold text-ink mb-4">Get YASS</h2>
					<p class="text-sm text-dim mb-4">Free, open source, and documented.</p>
					<a href="/projects" class="inline-block font-mono text-xs uppercase tracking-wider text-yass-600 hover:underline">
						Browse our projects &rarr;
					</a>
				</div>
			</aside>
		</div>
	</section>
</Layout>

<style>
	.post-content {
		max-width: 68ch;
	}
	.post-content :global(p) {
		margin-bottom: 1.5rem;
	}
	.post-content :global(p:last-child) {
		margin-bottom: 0;
	}
	/* Posts lead paragraphs with a bold phrase used as an inline section
	   label (e.g. "**Schema changes:** ...") -- give it real contrast and
	   room to breathe instead of blending into the body copy. */
	.post-content :global(p > strong:first-child) {
		color: var(--color-ink);
		display: inline-block;
		margin-bottom: 0.3rem;
	}
	.post-content :global(p:has(> strong:first-child)) {
		margin-top: 2rem;
	}
	.post-content :global(strong) {
		color: var(--color-ink);
		font-weight: 700;
	}
	.post-content :global(img) {
		width: 100%;
		border-radius: 2px;
		border: 1px solid var(--color-graphite-border);
		margin-bottom: 1.5rem;
	}
	.post-content :global(a) {
		color: var(--color-yass-600);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.post-content :global(code) {
		font-family: "JetBrains Mono", monospace;
		background: var(--color-graphite-raised);
		color: var(--color-yass-400);
		padding: 0.1rem 0.35rem;
		border-radius: 0.25rem;
		font-size: 0.82em;
	}
	.post-content :global(pre) {
		background: var(--color-graphite-raised);
		border: 1px solid var(--color-graphite-border);
		color: var(--color-ink);
		padding: 1rem;
		border-radius: 2px;
		overflow-x: auto;
		margin-bottom: 1.5rem;
		font-size: 0.85em;
	}
	.post-content :global(pre code) {
		background: transparent;
		color: inherit;
		padding: 0;
		white-space: pre;
	}
	.post-content :global(h2) {
		font-size: 1.4em;
		margin: 2.5rem 0 1rem;
	}
	.post-content :global(h3) {
		font-size: 1.15em;
		margin: 2rem 0 0.75rem;
	}
	.post-content :global(ul),
	.post-content :global(ol) {
		margin: 0 0 1.5rem 1.25rem;
	}
	.post-content :global(ul) {
		list-style: disc;
	}
	.post-content :global(ol) {
		list-style: decimal;
	}
	.post-content :global(li) {
		margin-bottom: 0.5rem;
	}
	.post-content :global(blockquote) {
		border-left: 2px solid var(--color-yass-600);
		padding-left: 1rem;
		color: var(--color-dim);
		font-style: italic;
		margin: 0 0 1.5rem;
	}
</style>
