---
import { storeUrl } from "../data/merch.js";
import Layout from "../layouts/Layout.astro";

const links = [
	{
		name: "Discord",
		description: "The fastest way to reach us. Ask setup questions, report bugs, or just say hi.",
		url: "https://discord.gg/yass",
	},
	{
		name: "GitHub",
		description: "File issues, open pull requests, or browse the source for any of our projects.",
		url: "https://github.com/Yet-Another-Software-Suite",
	},
	{
		name: "Instagram",
		description: "Quick updates, announcements, and Team YASS shoutouts.",
		url: "https://www.instagram.com/yassrobotics",
	},
];

const donateUrl = `${storeUrl}/pages/donations`;
---

<Layout
	title="Contact - Yet Another Software Suite"
	description="Get in touch with YASS on Discord, GitHub, or Instagram."
	url="https://yassrobotics.com/contact"
>
	<section class="py-16 sm:py-20 px-4 sm:px-6">
		<div class="max-w-3xl mx-auto text-center">
			<h1 class="text-4xl sm:text-5xl font-bold mb-4 sm:mb-6 text-yass-600">
				Get in Touch
			</h1>
			<p class="text-base sm:text-lg text-dim leading-relaxed">
				Stuck on a config, found a bug, or just wanna talk about robots? 
				Here's where to find us.
			</p>
		</div>
	</section>

	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-graphite-panel/40 border-y border-graphite-border">
		<div class="max-w-3xl mx-auto grid sm:grid-cols-3 gap-5">
			{links.map((link) => (
				<a
					href={link.url}
					target="_blank"
					rel="noopener noreferrer"
					class="block bg-graphite-panel border border-graphite-border rounded-sm p-6 text-center hover:border-yass-600 transition-colors"
				>
					<h2 class="font-bold text-lg text-yass-600 mb-2">{link.name}</h2>
					<p class="text-sm text-dim leading-relaxed">{link.description}</p>
				</a>
			))}
		</div>
	</section>

	<section class="py-16 sm:py-24 px-4 sm:px-6">
		<div class="max-w-xl mx-auto text-center scroll-animate">
			<h2 class="text-3xl sm:text-4xl font-bold text-yass-600 mb-4">Support YASS</h2>
			<p class="text-dim mb-8">
				<strong class="block text-ink font-bold mb-2">YASS is free and always will be.</strong>
				Donations cover things like backend infrastructure, site hosting, and commmunity materials like stickers,
			</p>
			<a
				href={donateUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider px-6 py-3.5 rounded-sm bg-yass-600 text-on-accent font-bold hover:bg-yass-500 transition-colors"
			>
				Donate &rarr;
			</a>
		</div>
	</section>
</Layout>
