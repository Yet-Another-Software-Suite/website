---
import { Image } from "astro:assets";
import partnerTeamsLogo from "../assets/logos/partner-teams-logo.png";
import { foundingTeams, testimonials, legacyTeams as legacyTeamsData } from "../data/teams.js";
import Layout from "../layouts/Layout.astro";

const legacyTeams = [...legacyTeamsData].sort((a, b) => a.number - b.number);
const partnerTeams = testimonials.filter((t) => !t.founding);
const foundingTestimonials = testimonials.filter((t) => t.founding);
const applyUrl = "https://docs.google.com/forms/d/e/1FAIpQLSdl3Jf_2HzPgFP8PF9abXcG21ZQ6LmE5BUKLv3bUopzj1wpzg/viewform";
---

<Layout
	title="Teams - Yet Another Software Suite"
	description="Meet the founding and partner FRC teams building and running YASS."
	url="https://yassrobotics.com/teams"
>
	<section class="py-16 sm:py-20 px-4 sm:px-6">
		<div class="max-w-3xl mx-auto text-center">
			<img src={partnerTeamsLogo.src} alt="Partner Teams logo" class="w-36 h-36 sm:w-44 sm:h-44 object-contain mx-auto mb-4" />
			<h1 class="text-4xl sm:text-5xl font-bold text-yass-600">
				Team YASS
			</h1>
		</div>
	</section>

	<section class="px-4 sm:px-6 pb-16 sm:pb-20">
		<div class="max-w-3xl mx-auto rounded-sm border border-partner-pink bg-partner-pink-soft p-6 sm:p-8 text-center">
			<p class="font-mono text-xs uppercase tracking-widest text-partner-pink mb-2">Applications are live</p>
			<h2 class="text-2xl sm:text-3xl font-bold text-ink mb-3">Partner Team applications are open!</h2>
			<p class="text-dim mb-6">
				Want to work closely with the YASS core team, test features early, and help YASS grow? Apply to become a 2026-2027 Partner Team.
			</p>
			<p class="font-mono text-sm font-bold text-partner-pink mb-6">Deadline: November 13</p>
			<a
				href={applyUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-block rounded-sm bg-partner-pink text-white font-bold font-mono text-xs uppercase tracking-wider px-6 py-3.5 hover:opacity-90 transition-opacity"
			>
				Apply now
			</a>
		</div>
	</section>

	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-graphite-panel/40">
		<div class="max-w-5xl mx-auto scroll-animate">
			<h2 class="text-3xl sm:text-4xl font-bold text-center mb-10 text-yass-600">Founding Teams</h2>
			<div class="grid sm:grid-cols-2 gap-5">
				{foundingTestimonials.map((t) => {
					const team = foundingTeams.find((f) => f.number === t.number);
					return (
						<figure class="bg-graphite-panel border border-graphite-border rounded-sm p-6 flex flex-col transition-colors hover:bg-yass-soft hover:border-yass-600">
							<div class="flex items-start justify-between gap-3 mb-4">
								<figcaption class="text-xl font-semibold text-ink">
									{team?.url ? (
										<a href={team.url} target="_blank" rel="noopener noreferrer" class="hover:text-yass-600 hover:underline">{t.team}</a>
									) : (
										t.team
									)} <span class="text-yass-600 text-base font-normal font-mono block">Team {t.number}</span>
								</figcaption>
								{t.logo ? (
									<div class="w-14 h-14 flex items-center justify-center shrink-0">
										<Image src={t.logo} alt={`${t.team} logo`} width={112} class="max-w-full max-h-full w-auto h-auto object-contain rounded-sm" />
									</div>
								) : (
									<div class="w-14 h-14 rounded-full bg-graphite-raised border border-graphite-border flex items-center justify-center shrink-0" aria-hidden="true">
										<span class="font-mono text-[10px] text-faint">{t.number}</span>
									</div>
								)}
							</div>
							{t.contributions?.length > 0 && (
								<span class="block font-mono text-[11px] uppercase tracking-widest text-faint mb-1.5">Contributions</span>
								<ul class="text-xs font-mono text-dim space-y-1 mb-4 list-disc list-inside">
									{t.contributions.map((c) => <li>{c}</li>)}
								</ul>
							)}
							{t.quote && (
								<blockquote class="text-sm sm:text-base text-dim leading-relaxed grow">
									"{t.quote}"
								</blockquote>
							)}
						</figure>
					);
				})}
			</div>
		</div>
	</section>

	<div class="hazard-stripe-partner"></div>

	<section class="py-16 sm:py-20 px-4 sm:px-6">
		<div class="max-w-5xl mx-auto scroll-animate">
			<h2 class="text-3xl sm:text-4xl font-bold text-center mb-2 text-partner-pink"> 2026 Partner Teams</h2>
			<div class="max-w-3xl mx-auto text-center text-dim mb-10 space-y-4">
				<p>YASS Partner Teams are FRC teams that work closely with the YASS development team to help improve and expand our open-source software. Partner Teams get early access to new features through alpha and beta testing, provide valuable feedback, host workshops, create tutorial videos, improve documentation, and promote YASS throughout the FIRST community.</p>
				<p>In recognition of their contributions, Partner Teams receive exclusive access to our Partner Team Pink logos and a dedicated channel in the YASS Discord server. The program celebrates teams that go beyond simply using our libraries by actively contributing to their development, supporting other teams, and helping make advanced robot programming more accessible to everyone.</p>
			</div>
			<div class="grid md:grid-cols-2 gap-5">
				{partnerTeams.map((t) => (
					<figure class="bg-graphite-panel border border-partner-pink-tint rounded-sm p-6 flex flex-col transition-colors hover:bg-partner-pink-soft hover:border-partner-pink">
						<div class="flex items-start justify-between gap-3 mb-4">
							<figcaption class="text-xl font-semibold text-ink">
								{t.url ? (
									<a href={t.url} target="_blank" rel="noopener noreferrer" class="hover:text-partner-pink hover:underline">{t.team}</a>
								) : (
									t.team
								)} <span class="text-partner-pink text-base font-normal font-mono block">Team {t.number}</span>
							</figcaption>
							{t.logo ? (
								<div class={`w-14 h-14 flex items-center justify-center shrink-0 ${t.logoBackdrop ? "bg-white rounded-sm p-1" : ""}`}>
									<Image src={t.logo} alt={`${t.team} logo`} width={112} class="max-w-full max-h-full w-auto h-auto object-contain rounded-sm" />
								</div>
							) : (
								<div class="w-14 h-14 rounded-full bg-graphite-raised border border-partner-pink-tint flex items-center justify-center shrink-0" aria-hidden="true">
									<span class="font-mono text-[10px] text-faint">{t.number}</span>
								</div>
							)}
						</div>
						{t.contributions?.length > 0 && (
							<span class="block font-mono text-[11px] uppercase tracking-widest text-faint mb-1.5">Contributions</span>
							<ul class="text-xs font-mono text-dim space-y-1 mb-4 list-disc list-inside">
								{t.contributions.map((c) => <li>{c}</li>)}
							</ul>
						)}
						{t.quote && (
							<blockquote class="text-sm sm:text-base text-dim leading-relaxed grow">
								"{t.quote}"
							</blockquote>
						)}
					</figure>
				))}
			</div>
		</div>
	</section>

	<div class="hazard-stripe-partner"></div>

	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-graphite-panel/40">
		<div class="max-w-5xl mx-auto scroll-animate">
			<h2 class="text-3xl sm:text-4xl font-bold text-center mb-2 text-metallic-gold">Legacy Teams</h2>
			<p class="text-center text-dim mb-10">Teams who made significant contributions to YASS previously, but are no longer involved with active development.</p>
			{legacyTeams.length > 0 ? (
				<div class="grid sm:grid-cols-2 gap-5">
					{legacyTeams.map((t) => (
						<figure class="bg-graphite-panel border border-legacy-gold-tint rounded-sm p-6 flex flex-col transition-colors hover:bg-legacy-gold-soft hover:border-legacy-gold">
							<div class="flex items-start justify-between gap-3 mb-4">
								<figcaption class="text-xl font-semibold text-ink">
									{t.url ? (
										<a href={t.url} target="_blank" rel="noopener noreferrer" class="hover:underline" style="color: inherit;">{t.team}</a>
									) : (
										t.team
									)} <span class="text-base font-normal font-mono block" style="color: var(--color-legacy-gold);">Team {t.number}</span>
								</figcaption>
								{t.logo ? (
									<div class="w-14 h-14 flex items-center justify-center shrink-0">
										<Image src={t.logo} alt={`${t.team} logo`} width={112} class="max-w-full max-h-full w-auto h-auto object-contain rounded-sm" />
									</div>
								) : (
									<div class="w-14 h-14 rounded-full bg-graphite-raised flex items-center justify-center shrink-0" style="border: 1px solid var(--color-legacy-gold-tint);" aria-hidden="true">
										<span class="font-mono text-[10px] text-faint">{t.number}</span>
									</div>
								)}
							</div>
							{t.contributions?.length > 0 && (
								<span class="block font-mono text-[11px] uppercase tracking-widest text-faint mb-1.5">Contributions</span>
								<ul class="text-xs font-mono text-dim space-y-1 mb-4 list-disc list-inside">
									{t.contributions.map((c) => <li>{c}</li>)}
								</ul>
							)}
							{t.quote && (
								<blockquote class="text-sm sm:text-base text-dim leading-relaxed grow">
									"{t.quote}"
								</blockquote>
							)}
						</figure>
					))}
				</div>
			) : (
				<p class="text-center text-dim">None yet.</p>
			)}
		</div>
	</section>

	<section class="py-16 sm:py-24 px-4 sm:px-6 border-t border-graphite-border">
		<div class="max-w-2xl mx-auto text-center scroll-animate">
			<h2 class="text-3xl sm:text-4xl font-bold text-yass-600 mb-4">Want to Become a Partner Team?</h2>
			<p class="text-dim mb-8">
				Partner Team applications for the 2026-2027 season are now open, with a deadline of November 13. Apply below, and join the Discord or follow on Instagram for updates.
			</p>
			<div class="flex flex-wrap justify-center gap-3">
				<a
					href={applyUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-block rounded-sm bg-partner-pink text-white font-bold font-mono text-xs uppercase tracking-wider px-6 py-3.5 hover:opacity-90 transition-opacity"
				>
					Apply now
				</a>
				<a
					href="https://discord.gg/yass"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-block rounded-sm bg-yass-600 text-on-accent font-bold font-mono text-xs uppercase tracking-wider px-6 py-3.5 hover:bg-yass-500 transition-colors"
				>
					Join the Discord
				</a>
				<a
					href="https://www.instagram.com/yassrobotics"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-block rounded-sm border border-faint text-ink font-mono text-xs uppercase tracking-wider px-6 py-3.5 hover:border-yass-600 hover:text-yass-600 transition-colors"
				>
					Follow us on Instagram
				</a>
			</div>
		</div>
	</section>
</Layout>
