---
import { foundingTeams, testimonials } from "../data/teams.js";
import Layout from "../layouts/Layout.astro";

const partnerTeams = testimonials.filter((t) => !t.founding);
const foundingTestimonials = testimonials.filter((t) => t.founding);
---

<Layout
	title="Teams - Yet Another Software Suite"
	description="Meet the founding and partner FRC teams building and running YASS."
	url="https://yassrobotics.com/teams"
>
	<section class="bg-white dark:bg-neutral-950 py-16 sm:py-20 px-4 sm:px-6">
		<div class="max-w-3xl mx-auto text-center">
			<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 sm:mb-6 text-neutral-900 dark:text-white">
				Our Teams
			</h1>
			<p class="text-base sm:text-lg md:text-xl text-neutral-600 dark:text-neutral-300 leading-relaxed">
				YASS is run by students on FRC teams, for FRC teams. Here's who's building it and who's using it.
			</p>
		</div>
	</section>

	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-neutral-50 dark:bg-neutral-900">
		<div class="max-w-5xl mx-auto scroll-animate">
			<h2 class="text-2xl sm:text-3xl font-bold text-center mb-8 sm:mb-12 text-neutral-900 dark:text-white">Founding Teams</h2>
			<div class="grid sm:grid-cols-2 gap-6">
				{foundingTestimonials.map((t) => {
					const team = foundingTeams.find((f) => f.number === t.number);
					return (
						<figure class="bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-lg p-6 flex flex-col">
							<blockquote class="text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed mb-4 grow">
								"{t.quote}"
							</blockquote>
							<figcaption class="text-sm font-semibold text-neutral-900 dark:text-white">
								{team?.url ? (
									<a href={team.url} target="_blank" rel="noopener noreferrer" class="hover:text-yass-600 dark:hover:text-yass-400 hover:underline">{t.team}</a>
								) : (
									t.team
								)} <span class="text-neutral-500 dark:text-neutral-400 font-normal">Team {t.number}</span>
							</figcaption>
						</figure>
					);
				})}
			</div>
		</div>
	</section>

	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-white dark:bg-neutral-950">
		<div class="max-w-5xl mx-auto scroll-animate">
			<h2 class="text-2xl sm:text-3xl font-bold text-center mb-2 text-neutral-900 dark:text-white">Partner Teams</h2>
			<p class="text-center text-neutral-600 dark:text-neutral-300 mb-8 sm:mb-12">Teams running YASS in competition, in their own words.</p>
			<div class="grid md:grid-cols-2 gap-6">
				{partnerTeams.map((t) => (
					<figure class="bg-neutral-50 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 rounded-lg p-6 flex flex-col">
						<blockquote class="text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed mb-4 grow">
							"{t.quote}"
						</blockquote>
						<figcaption class="text-sm font-semibold text-neutral-900 dark:text-white">
							{t.url ? (
								<a href={t.url} target="_blank" rel="noopener noreferrer" class="hover:text-yass-600 dark:hover:text-yass-400 hover:underline">{t.team}</a>
							) : (
								t.team
							)} <span class="text-neutral-500 dark:text-neutral-400 font-normal">Team {t.number}</span>
						</figcaption>
					</figure>
				))}
			</div>
		</div>
	</section>

	<section class="py-16 sm:py-24 px-4 sm:px-6 bg-yass-700">
		<div class="max-w-2xl mx-auto text-center scroll-animate">
			<h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Want to Become a Partner Team?</h2>
			<p class="text-yass-100 mb-8">
				If your team is running YASS and wants to be featured here, drop by the Discord and let us know.
			</p>
			<a
				href="https://discord.gg/yass"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-block rounded-md bg-white text-yass-700 font-semibold px-8 py-3 hover:bg-yass-50 transition-colors"
			>
				Join the Discord
			</a>
		</div>
	</section>
</Layout>
